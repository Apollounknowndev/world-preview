# Sets default memory used for gradle commands. Can be overridden by user or command line properties.
org.gradle.jvmargs=-Xmx3G
org.gradle.daemon=false

## Environment Properties

minecraft_version=1.21.1
minecraft_version_range=[1.21.1]
neo_version=21.1.234
# The loader version range can only use the major version of FML as bounds
loader_version_range=[1,)

# Parchment provides parameter names and javadocs on top of the official mappings
parchment_minecraft_version=1.21.1
parchment_mappings_version=2024.11.17

## Mod Properties

mod_id=world_preview
mod_name=World Preview
mod_license=Apache-2.0
mod_version=1.3.1
mod_group_id=caeruleusTait
mod_authors=Caeruleus Draconis and Taiterio
mod_description=World Preview adds a new tab in the World creation screen to preview a seed
