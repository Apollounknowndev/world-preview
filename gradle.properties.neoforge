mod_id=world_preview
mod_name=World Preview
mod_license=Apache-2.0
mod_version=1.3.1
mod_group_id=caeruleusTait
mod_authors=Caeruleus Draconis and Taiterio
mod_description=World Preview adds a new tab in the World creation screen to preview a seed
